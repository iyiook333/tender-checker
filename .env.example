# CCSwitch / 云渡 configuration examples (optional)
# The web form is intentionally blank by default. Do not add real credentials here.
CCSWITCH_BASE_URL=
CCSWITCH_API_KEY=PROXY_MANAGED
CCSWITCH_MODEL=
CCSWITCH_PROTOCOL=
CCSWITCH_TIMEOUT_SECONDS=120
CHECKER_MAX_FILE_MB=20
CHECKER_CHUNK_CHARS=12000
CHECKER_MAX_CHUNKS=80
CHECKER_MAX_CONCURRENCY=2
CHECKER_MAX_ACTIVE_TASKS=1
CHECKER_TASK_TTL_SECONDS=3600
CHECKER_MAX_RETAINED_TASKS=100
# Set to 1 for a local parser-only demo without paid model calls.
CHECKER_MOCK_LLM=0
# Optional: full path to pdftotext when it is not available on PATH.
CHECKER_PDFTOTEXT_PATH=
